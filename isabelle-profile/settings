# Memory and heap isolation for this UTP stack on patched Isabelle2026.
#
# Copy this file to:
#
#   $HOME/.isabelle/$UTP_PROFILE/etc/settings
#
# These defaults give jEdit/PIDE and Poly/ML more memory for the large UTP
# sessions. Increase or decrease them if your machine needs a different memory
# budget.

ISABELLE_TOOL_JAVA_OPTIONS="-Djava.awt.headless=true -Xms512m -Xmx4g -Xss16m"
ML_OPTIONS="--minheap 1000 --maxheap 4000"

# Rebuild every image from patched Pure; never read distribution heaps.
ISABELLE_HEAPS_SYSTEM="$ISABELLE_HOME_USER/disabled-distribution-heaps"
